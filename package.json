{
  "name": "mauves-wave",
  "version": "1.0.0",
  "private": true,
  "description": "Forecast of the static wave on the Loire at Mauves-sur-Loire",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsc -p tsconfig.json && node dist/server.js",
    "watch": "tsc -p tsconfig.json --incremental && (tsc -p tsconfig.json --incremental --noEmitOnError --watch --preserveWatchOutput & node --watch dist/server.js)",
    "backtest": "tsc -p tsconfig.json && node dist/backtest.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.21.2",
    "luxon": "^3.5.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
