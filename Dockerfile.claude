# Claude Code CLI for the Mauves wave project. Runs apart from the website container;
# the project folder and the website's data are mounted in by docker-compose.yml.
FROM node:22-bookworm-slim

# Tools Claude Code works best with (git, ripgrep) and a few basics
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ripgrep ca-certificates curl less procps \
 && rm -rf /var/lib/apt/lists/*

# Claude Code CLI, installed globally
RUN npm install -g @anthropic-ai/claude-code && npm cache clean --force

# Claude Code keeps its settings, login and history in CLAUDE_CONFIG_DIR (including the
# .claude.json file), so one volume mounted there keeps everything between container runs.
# The directories are created here, owned by the "node" user, so that fresh named volumes
# get the right owner.
ENV CLAUDE_CONFIG_DIR=/home/node/.claude \
    DISABLE_AUTOUPDATER=1 \
    DATA_DIR=/data \
    PORT=3000 \
    TZ=Europe/Paris
RUN mkdir -p /home/node/.claude /data /app \
 && chown -R node:node /home/node/.claude /data /app

WORKDIR /app
USER node

# The project's dependencies, so Claude can run tsc, the backtest and a local server.
# The source itself is mounted at /app.
COPY --chown=node:node package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

VOLUME ["/home/node/.claude"]
CMD ["claude"]
